%%{init: {'theme': 'neutral'} }%%
classDiagram
    class UserController["@Controller<br/>UserController"] {
        -userService: UserService
    }
    class EventController["@Controller<br/>EventController"] {
        -eventService: EventService
    }

    class UserService {
      <<Interface>>
    }

    class EventService {
      <<Interface>>
    }

    class UserServiceImplementation["@Service<br/>UserServiceImplementation"] {
        -userRepository: UserRepository
    }
    class EventServiceImplementation["@Service<br/>EventServiceImplementation"] {
        -eventRepository: EventRepository
    }

    class UserRepository {
      <<Interface>>
    }

    class EventRepository {
      <<Interface>>
    }

    class UserEntity["@Entity<br/>User"] {
        -userId: Long
        -username: String
        -image: String
        -description: String
        -role: Role
    }

    class EventEntity["@Entity<br/>Event"] {
        -eventId: Long
        -name: String
        -date: LocalDate
        -location: String
        -organizer: User
        -description: String
        -tag: String
        -image: String
    }

    class Role {
        <<Enumeration>>
        MEMBER
        ORGANIZER
        ADMIN
    }

    UserController --> UserService
    EventController --> EventService

    UserService <|.. UserServiceImplementation
    EventService <|.. EventServiceImplementation

    UserServiceImplementation --> UserRepository
    EventServiceImplementation --> EventRepository

    UserEntity <-- EventEntity
    UserEntity --> Role
